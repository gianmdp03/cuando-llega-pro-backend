# ==============================================================================
# VARIABLES DE ENTORNO PARA PRODUCCIÓN / VPS
# Copiar este archivo a .env en el VPS: cp .env.example .env
# ==============================================================================

# Base de datos PostgreSQL
POSTGRES_DB=cuando_llega_pro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_por_una_password_segura

# Hibernate DDL Auto (update o validate para produccion)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Secret Key para firmas JWT (minimo 256 bits en base64)
# Puedes generar uno con: openssl rand -base64 32
JWT_SECRET=lyYajqknQ9Gp5BWh2YjBu+RuNaMbNxgTR9Wi7GD1big=

# Credenciales del usuario Administrador inicial (opcional)
APP_ADMIN_EMAIL=admin@cuandollega.pro
APP_ADMIN_PASSWORD=PasswordAdminSegura2026!
APP_ADMIN_FULL_NAME=Administrador Sistema
